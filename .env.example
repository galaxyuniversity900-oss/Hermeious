PORT=8787
MAX_RISK=medium
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat
# Workspace root for local file capabilities.
HERMEIOUS_WORKSPACE=./workspace
# Optional HTTP capability providers. Each endpoint receives { capability, input, requestId }.
HERMEIOUS_SEARCH_URL=
HERMEIOUS_CODE_EXECUTOR_URL=
HERMEIOUS_PDF_URL=
HERMEIOUS_DOCX_URL=
HERMEIOUS_XLSX_URL=
HERMEIOUS_IMAGE_URL=
HERMEIOUS_VIDEO_URL=
# DAG controls.
DAG_CONCURRENCY=4
MAX_REPLANS=2
# Comma-separated host allowlist for outbound MCP connections.
# Keep localhost-only until you explicitly trust a remote MCP server.
MCP_ALLOWED_HOSTS=localhost,127.0.0.1
